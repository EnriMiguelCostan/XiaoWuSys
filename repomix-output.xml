<file path="Backend/migrations/003_inventory_change_notify.sql">
-- ==========================================
-- 003: Real-time stock change notifications
-- Every INSERT / UPDATE / DELETE on inventory_items sends a NOTIFY on the
-- 'inventory_changed' channel. Each backend LISTENs (services/inventoryEvents.js) and
-- pushes a fresh snapshot to its browsers over Socket.io, so a stock change made by
-- ANY branch, script or SQL editor session reaches every connected screen.
--
-- NOTIFY is transactional: it is only delivered if the transaction COMMITs.
-- Payload: {"inventory_id": "...", "op": "INSERT|UPDATE|DELETE"}
-- Idempotent. Apply with:  npm run migrate
-- ==========================================

CREATE OR REPLACE FUNCTION notify_inventory_changed()
RETURNS trigger
LANGUAGE plpgsql
AS $$
DECLARE
  changed_id VARCHAR(50);
BEGIN
  IF TG_OP = 'DELETE' THEN
    changed_id := OLD.inventory_id;
  ELSE
    changed_id := NEW.inventory_id;
    -- Skip no-op updates (same values), e.g. sync re-sending unchanged rows
    IF TG_OP = 'UPDATE' AND (to_jsonb(NEW) - 'last_modified') = (to_jsonb(OLD) - 'last_modified') THEN
      RETURN NULL;
    END IF;
  END IF;
  PERFORM pg_notify('inventory_changed', json_build_object('inventory_id', changed_id, 'op', TG_OP)::text);
  RETURN NULL;
END;
$$;

DROP TRIGGER IF EXISTS trg_inventory_items_notify ON inventory_items;
CREATE TRIGGER trg_inventory_items_notify
  AFTER INSERT OR UPDATE OR DELETE ON inventory_items
  FOR EACH ROW EXECUTE FUNCTION notify_inventory_changed();
</file>

<file path="Backend/migrations/004_recycle_bin_audit_order_stock.sql">
-- ==========================================
-- 004: Catalog Recycle Bin, backend-only audit trail, duplicate guard, order stock link
-- Idempotent (IF NOT EXISTS / guarded). Applied automatically on server start-up, or with:
--   npm run migrate
-- ==========================================

-- 1. Recycle Bin (soft delete). Deleted items keep every value and can be restored.
--    purged_at = "permanently deleted" but kept because past orders/losses still reference it.
ALTER TABLE inventory_items ADD COLUMN IF NOT EXISTS deleted_at TIMESTAMP;
ALTER TABLE inventory_items ADD COLUMN IF NOT EXISTS deleted_by VARCHAR(50);
ALTER TABLE inventory_items ADD COLUMN IF NOT EXISTS purged_at  TIMESTAMP;

-- Partial indexes: the catalog and the bin each scan only their own rows, so a large
-- Recycle Bin never slows the main catalog down.
CREATE INDEX IF NOT EXISTS idx_inventory_items_active
  ON inventory_items (item_name) WHERE deleted_at IS NULL AND purged_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_inventory_items_recycle_bin
  ON inventory_items (deleted_at DESC) WHERE deleted_at IS NOT NULL AND purged_at IS NULL;

-- 2. No duplicate item names (case and spaces ignored: "Deli A4" = "deli  a4" = "DeliA4").
--    Only created when the existing data has no duplicates yet; otherwise the backend's own
--    check still blocks new duplicates and this NOTICE says which rows to merge first.
DO $$
DECLARE
  dupes TEXT;
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_indexes WHERE indexname = 'uq_inventory_items_name') THEN
    SELECT string_agg(names, '; ') INTO dupes FROM (
      SELECT string_agg(item_name, ' / ') AS names
        FROM inventory_items WHERE purged_at IS NULL
       GROUP BY LOWER(REGEXP_REPLACE(item_name, '\s', '', 'g')) HAVING COUNT(*) > 1
    ) d;
    IF dupes IS NULL THEN
      CREATE UNIQUE INDEX uq_inventory_items_name
        ON inventory_items (LOWER(REGEXP_REPLACE(item_name, '\s', '', 'g'))) WHERE purged_at IS NULL;
    ELSE
      RAISE NOTICE 'Duplicate inventory names exist (%). Unique index skipped; merge them, then re-run.', dupes;
    END IF;
  END IF;
END $$;

-- 3. Audit trail (track / trace). Written by the backend in the SAME transaction as every
--    catalog change. Not exposed on the website. Append-only: rows cannot be edited or deleted.
CREATE TABLE IF NOT EXISTS inventory_audit_log (
    audit_id       VARCHAR(50) PRIMARY KEY,
    inventory_id   VARCHAR(50) NOT NULL,          -- no FK: survives a permanent delete
    action         VARCHAR(30) NOT NULL CHECK (action IN
                     ('created', 'edited', 'stock_added', 'stock_subtracted', 'deleted', 'restored', 'purged')),
    item_name      VARCHAR(255),
    details        TEXT,                          -- JSON: full item snapshot / before-after values
    performed_by   VARCHAR(50),
    performed_role VARCHAR(50),
    created_at     TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    sync_status    VARCHAR(50) DEFAULT 'synced' CHECK (sync_status IN ('synced', 'pending_insert', 'pending_update')),
    last_modified  TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_inventory_audit_item ON inventory_audit_log (inventory_id, created_at DESC);
CREATE INDEX IF NOT EXISTS idx_inventory_audit_time ON inventory_audit_log (created_at DESC);

CREATE OR REPLACE FUNCTION forbid_audit_change()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
  RAISE EXCEPTION 'inventory_audit_log is append-only';
END;
$$;
DROP TRIGGER IF EXISTS trg_inventory_audit_log_append_only ON inventory_audit_log;
CREATE TRIGGER trg_inventory_audit_log_append_only
  BEFORE UPDATE OR DELETE ON inventory_audit_log
  FOR EACH ROW EXECUTE FUNCTION forbid_audit_change();

-- 4. Orders hold their materials: stock_reserved = this order's items are counted in
--    inventory_items.quantity_reserved (released on Cancel, consumed on Complete).
ALTER TABLE order_profiles ADD COLUMN IF NOT EXISTS stock_reserved BOOLEAN NOT NULL DEFAULT FALSE;
CREATE INDEX IF NOT EXISTS idx_order_items_order ON order_items (order_id);
CREATE INDEX IF NOT EXISTS idx_order_profiles_created ON order_profiles (date_created DESC);
</file>

<file path="Backend/migrations/005_job_order_approval.sql">
-- ==========================================
-- 005: Job order approval (Sprint 11 / PB 13)
--
--   * order_profiles.approved_by / approved_at  (who approved a job order, and when)
--   * 'Approved' added to the production_status CHECK constraint
--     Lifecycle: Pending -> Approved -> Printing -> Completed, plus Delayed / Cancelled
--   * defence-in-depth CHECK on inventory_items: reserved and available never negative
--
-- Stock reservation itself uses order_profiles.stock_reserved from migration 004.
--
-- SAFE TO RUN MORE THAN ONCE. Columns use IF NOT EXISTS; constraints are dropped by name
-- with IF EXISTS before being re-added. Applied automatically on server start-up, or with:
--   npm run migrate
-- ==========================================

-- ---------- 1. Approval columns on order_profiles ----------
ALTER TABLE order_profiles ADD COLUMN IF NOT EXISTS approved_by VARCHAR(50);
ALTER TABLE order_profiles ADD COLUMN IF NOT EXISTS approved_at TIMESTAMP;

ALTER TABLE order_profiles DROP CONSTRAINT IF EXISTS order_profiles_approved_by_fkey;
ALTER TABLE order_profiles
  ADD CONSTRAINT order_profiles_approved_by_fkey
  FOREIGN KEY (approved_by) REFERENCES users(user_id) ON DELETE SET NULL;

-- ---------- 2. Add 'Approved' to the production_status CHECK ----------
-- Postgres cannot edit a CHECK in place, so drop and re-add. The inline CHECK from schema.sql
-- is named order_profiles_production_status_check, but a legacy database may carry one under
-- another name, so every CHECK on order_profiles that mentions production_status is dropped.
DO $$
DECLARE
  c record;
BEGIN
  FOR c IN
    SELECT conname FROM pg_constraint
     WHERE conrelid = 'order_profiles'::regclass AND contype = 'c'
       AND pg_get_constraintdef(oid) ILIKE '%production_status%'
  LOOP
    EXECUTE format('ALTER TABLE order_profiles DROP CONSTRAINT %I', c.conname);
  END LOOP;
END $$;
ALTER TABLE order_profiles
  ADD CONSTRAINT order_profiles_production_status_check
  CHECK (production_status IN ('Pending', 'Approved', 'Printing', 'Completed', 'Delayed', 'Cancelled'));

-- ---------- 3. Defence-in-depth stock guard on inventory_items ----------
-- Added NOT VALID so it always applies to new writes, then validated against existing rows.
-- If an existing row is already negative, validation is skipped with a NOTICE naming the
-- rows, instead of failing this migration on every server start. Fix them, then re-run
-- "ALTER TABLE inventory_items VALIDATE CONSTRAINT inventory_items_nonnegative_check".
ALTER TABLE inventory_items DROP CONSTRAINT IF EXISTS inventory_items_nonnegative_check;
ALTER TABLE inventory_items
  ADD CONSTRAINT inventory_items_nonnegative_check
  CHECK (quantity_reserved >= 0 AND quantity_available >= 0) NOT VALID;

DO $$
DECLARE
  bad TEXT;
BEGIN
  SELECT string_agg(inventory_id || ' (' || item_name || ')', ', ') INTO bad
    FROM inventory_items WHERE quantity_reserved < 0 OR quantity_available < 0;
  IF bad IS NULL THEN
    ALTER TABLE inventory_items VALIDATE CONSTRAINT inventory_items_nonnegative_check;
  ELSE
    RAISE NOTICE 'Negative stock found in: %. The CHECK applies to new writes only until these rows are fixed.', bad;
  END IF;
END $$;
</file>

