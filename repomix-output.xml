<file path="Backend/services/domain/orderLifecycle.js">
// ==========================================
// ORDER LIFECYCLE (pure rules: no HTTP, no SQL)
//
//   Pending  -> Cancelled             (Pending -> Approved only through the Owner's Approve)
//   Approved -> Printing | Cancelled
//   Printing -> Completed | Cancelled
//   Delayed  -> Pending (reserves stock) | Cancelled
//   Completed / Cancelled are final.
//
// allowedActions() tells a client which buttons to show for an order and a role, so screens
// never re-implement these rules. The server still checks every action when it is sent.
// ==========================================
const { can } = require('./permissions');
const { paymentSummary, paymentBlockedReason } = require('./payments');

const STATUS_TRANSITIONS = {
  Pending: ['Cancelled'],
  Approved: ['Printing', 'Cancelled'],
  Printing: ['Completed', 'Cancelled'],
  Delayed: ['Pending', 'Cancelled'],
  Completed: [],
  Cancelled: []
};

const CLOSED_STATUSES = ['Completed', 'Cancelled'];
const EDITABLE_STATUSES = ['Pending', 'Approved', 'Printing', 'Delayed'];
// The quote is frozen from approval on: the 50% downpayment was checked against it
const QUOTE_FROZEN_STATUSES = ['Approved', 'Printing', 'Completed', 'Cancelled'];
const QUOTE_EDITABLE_STATUSES = EDITABLE_STATUSES.filter((s) => !QUOTE_FROZEN_STATUSES.includes(s));
const APPROVABLE_STATUSES = ['Pending', 'Delayed'];

// Which capability a status change needs. Cancelling an existing order is a void (Owner only).
const capabilityForTransition = (to) => (to === 'Cancelled' ? 'void_order' : 'change_status');

const canTransition = (from, to) => (STATUS_TRANSITIONS[from] || []).includes(to);

// -> { approve, statuses: [...], edit_deadline, edit_quote, link_design, add_items,
//      record_payment, max_payment, payment_blocked_reason, print_receipt }
// Based on role, status and the payment totals (paymentSummary). Whether the cloud is
// reachable is reported separately (the response's "source" and the order's sync_status).
//   record_payment  PB 21: never on a Cancelled order, never without a quote, never once fully paid
//   max_payment     the remaining balance, so a screen can limit its amount field
const allowedActions = (order, role, summary = null) => {
  const status = order && order.production_status;
  const editable = EDITABLE_STATUSES.includes(status);
  const totals = summary || paymentSummary({ quote: order ? order.total_quote_amount : 0, payments: [] });
  const blocked = paymentBlockedReason(order, totals);
  const mayPay = Boolean(status) && can(role, 'record_payment');
  return {
    approve: can(role, 'approve_order') && APPROVABLE_STATUSES.includes(status),
    statuses: (STATUS_TRANSITIONS[status] || []).filter((to) => can(role, capabilityForTransition(to))),
    edit_deadline: editable && can(role, 'edit_order'),
    edit_quote: QUOTE_EDITABLE_STATUSES.includes(status) && can(role, 'set_quote'),
    link_design: editable && can(role, 'edit_order'),
    add_items: editable && can(role, 'edit_order'),
    record_payment: mayPay && !blocked,
    max_payment: mayPay && !blocked ? totals.remaining : 0,
    payment_blocked_reason: mayPay ? blocked : null,
    print_receipt: can(role, 'view_orders')
  };
};

module.exports = {
  STATUS_TRANSITIONS,
  CLOSED_STATUSES,
  EDITABLE_STATUSES,
  QUOTE_FROZEN_STATUSES,
  QUOTE_EDITABLE_STATUSES,
  APPROVABLE_STATUSES,
  capabilityForTransition,
  canTransition,
  allowedActions
};
</file>

<file path="Backend/services/domain/payments.js">
// ==========================================
// PAYMENT RULES (PB 21; pure rules: no HTTP, no SQL)
//
// All money is compared in integer centavos, so ₱999.99 never turns into 999.9899999.
//
//   payment_status   'Unpaid' | 'Partial' | 'Fully Paid' | 'Overpaid'
//                    Separate from the production status (D4): an order can be Printing and
//                    Partial at the same time.
//   remaining        what the order can still take (never below 0)
//   overpaid_by      paid above the quote. Only happens when branches together overpay while
//                    offline (D2): sync never refuses a payment, so the Owner reviews it and
//                    refunds by hand.
//   downpayment      50% of the quote, rounded up to the centavo (like the approve route).
//                    Only payments already in the cloud count toward it ("paid_synced").
// ==========================================

const DOWNPAYMENT_STATUSES = ['Pending', 'Delayed']; // not approved yet

const toCentavos = (pesos) => Math.round(Number(pesos || 0) * 100);
const toPesos = (centavos) => Math.round(centavos) / 100;

// '₱1,234.50' (for messages; screens format numbers themselves)
const pesoText = (pesos) =>
  `₱${Number(pesos || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

const statusFor = (quoteC, paidC) => {
  if (paidC <= 0) return 'Unpaid';
  if (quoteC <= 0 || paidC > quoteC) return 'Overpaid';
  return paidC === quoteC ? 'Fully Paid' : 'Partial';
};

// payments: [{ amount, sync_status }] (sync_status missing = in the cloud)
const paymentSummary = ({ quote, payments = [] }) => {
  const quoteC = Math.max(0, toCentavos(quote));
  let paidC = 0;
  let syncedC = 0;
  for (const p of payments) {
    const c = toCentavos(p.amount);
    paidC += c;
    if (!p.sync_status || p.sync_status === 'synced') syncedC += c;
  }
  const requiredC = Math.ceil(quoteC / 2);
  return {
    quote: toPesos(quoteC),
    total_paid: toPesos(paidC),
    remaining: toPesos(Math.max(0, quoteC - paidC)),
    overpaid_by: toPesos(Math.max(0, paidC - quoteC)),
    payment_status: statusFor(quoteC, paidC),
    downpayment: {
      required: toPesos(requiredC),
      paid_synced: toPesos(syncedC),
      met: quoteC > 0 && syncedC >= requiredC
    }
  };
};

// The totals right after each payment, in the order given (oldest first), for receipts:
// -> [{ payment_id, paid_to_date, remaining_after, status_after }]
const runningTotals = ({ quote, payments = [] }) => {
  const quoteC = Math.max(0, toCentavos(quote));
  let paidC = 0;
  return payments.map((p) => {
    paidC += toCentavos(p.amount);
    return {
      payment_id: p.payment_id,
      paid_to_date: toPesos(paidC),
      remaining_after: toPesos(Math.max(0, quoteC - paidC)),
      status_after: statusFor(quoteC, paidC)
    };
  });
};

// Whether a new payment may be recorded now. Amounts in pesos; paid = what is already paid
// in the view being checked (the cloud online, the local copy offline).
// -> null (allowed) | { status, body: { error, message, ...details } }
const checkPayment = ({ status, quote, paid, amount }) => {
  if (status === 'Cancelled') {
    return {
      status: 409,
      body: { error: 'ORDER_CLOSED', message: 'This order was cancelled, so it cannot take payments.' }
    };
  }
  const quoteC = toCentavos(quote);
  if (quoteC <= 0) {
    return {
      status: 422,
      body: { error: 'QUOTE_REQUIRED', message: 'This order has no price yet. Ask the Owner to set the quote before recording a payment.' }
    };
  }
  const paidC = toCentavos(paid);
  const remainingC = Math.max(0, quoteC - paidC);
  if (toCentavos(amount) > remainingC) {
    return {
      status: 409,
      body: {
        error: 'PAYMENT_EXCEEDS_BALANCE',
        message: remainingC === 0
          ? 'This order is already fully paid, so no more payments can be added.'
          : `The most this order can take now is ${pesoText(toPesos(remainingC))} (the remaining balance).`,
        remaining: toPesos(remainingC),
        total_paid: toPesos(paidC),
        total_quote_amount: toPesos(quoteC)
      }
    };
  }
  return null;
};

// Non-blocking notes after a payment (UAC exception for PB 21). Only for orders that are not
// approved yet. paidTotal includes this payment; paidSynced counts cloud payments only.
const downpaymentWarnings = ({ status, quote, paidTotal, paidSynced }) => {
  if (!DOWNPAYMENT_STATUSES.includes(status)) return [];
  const requiredC = Math.ceil(Math.max(0, toCentavos(quote)) / 2);
  if (requiredC <= 0) return [];
  const totalC = toCentavos(paidTotal);
  if (totalC < requiredC) {
    return [{
      code: 'DOWNPAYMENT_SHORT',
      message: `Not enough downpayment to start production: ${pesoText(toPesos(requiredC - totalC))} more is needed (50% of the quote).`
    }];
  }
  if (toCentavos(paidSynced) < requiredC) {
    return [{
      code: 'DOWNPAYMENT_NOT_SYNCED',
      message: 'The downpayment is complete, but some of it was saved offline. It counts for approval once it syncs to the cloud.'
    }];
  }
  return [];
};

// Why the payment form is hidden for this order, in plain words (null = it is shown)
const paymentBlockedReason = (order, summary) => {
  if (!order) return null;
  if (order.production_status === 'Cancelled') return 'This order was cancelled, so it cannot take payments.';
  if (summary.quote <= 0) return 'The Owner must set the quote before payments can be recorded.';
  if (summary.remaining <= 0) return 'This order is fully paid.';
  return null;
};

module.exports = {
  DOWNPAYMENT_STATUSES,
  toCentavos,
  toPesos,
  pesoText,
  paymentSummary,
  runningTotals,
  checkPayment,
  downpaymentWarnings,
  paymentBlockedReason
};
</file>

<file path="Backend/services/domain/permissions.js">
// ==========================================
// WHO MAY DO WHAT (pure rules: no HTTP, no SQL)
// One table of capabilities, used by the routes (requireRole) and returned to the screens,
// so a client (today's Vite app, the future Next.js / mobile apps) never keeps its own copy.
// The role always comes from the verified login token.
// ==========================================

const ALL_ROLES = ['Owner', 'Admin', 'Production', 'Staff'];
const WRITE_ROLES = ['Owner', 'Admin', 'Production'];
const MANAGER_ROLES = ['Owner', 'Admin'];
const OWNER_ONLY = ['Owner'];

// Owner-only financial decisions (SIA 1 "Authority Limits", UAC PB 2): only the Owner sets
// or changes a quote, gives discounts, voids (cancels) an order and approves job orders.
const CAPABILITIES = {
  view_orders: ALL_ROLES,
  create_order: WRITE_ROLES,
  edit_order: WRITE_ROLES,        // deadline, design link, print details
  change_status: WRITE_ROLES,     // Start Printing, Mark Completed, Resume
  record_payment: WRITE_ROLES,
  set_quote: OWNER_ONLY,
  apply_discount: OWNER_ONLY,     // reserved for PB 12
  void_order: OWNER_ONLY,         // cancel an existing order (releases its stock)
  approve_order: OWNER_ONLY,
  view_finance: MANAGER_ROLES,
  manage_accounts: MANAGER_ROLES
};

const rolesWith = (capability) => {
  const roles = CAPABILITIES[capability];
  if (!roles) throw new Error(`Unknown capability: ${capability}`);
  return roles;
};

const can = (role, capability) => rolesWith(capability).includes(role);

const capabilitiesFor = (role) => Object.keys(CAPABILITIES).filter((c) => CAPABILITIES[c].includes(role)).sort();

module.exports = { CAPABILITIES, ALL_ROLES, WRITE_ROLES, MANAGER_ROLES, rolesWith, can, capabilitiesFor };
</file>

<file path="Backend/services/domain/stockCheck.js">
// ==========================================
// STOCK CHECK FOR AN ORDER (pure rules: no HTTP, no SQL) - PB 9
// Tells the screens, before anyone presses Approve or Resume, whether the free stock covers
// the order. Only orders that do not hold their stock yet need it (stock_reserved = false,
// status Pending or Delayed): an order that already holds its reservation is covered.
// The approve / resume routes still re-check on locked rows; this is only advice.
// ==========================================
const { APPROVABLE_STATUSES } = require('./orderLifecycle');

const needsReservation = (order) => Boolean(order) && !order.stock_reserved && APPROVABLE_STATUSES.includes(order.production_status);

// Order items -> [{ inventory_id, quantity_needed }] (lines of the same material added up)
const stockNeeds = (items) => {
  const totals = new Map();
  for (const it of items || []) {
    if (!it.inventory_id) continue;
    totals.set(it.inventory_id, (totals.get(it.inventory_id) || 0) + Number(it.quantity || 0));
  }
  return [...totals].map(([inventory_id, quantity_needed]) => ({ inventory_id, quantity_needed }));
};

// evaluation: { source, missing: [ids], shortages: [{ inventory_id, item_name, requested, available, shortfall }] }
// -> { needs_reservation, sufficient, shortfalls: [{ inventory_id, item_name, needed, free, shortfall, missing }], source }
const buildStockCheck = (order, items, evaluation) => {
  if (!needsReservation(order)) {
    return { needs_reservation: false, sufficient: true, shortfalls: [], source: null };
  }
  const needs = stockNeeds(items);
  const neededById = new Map(needs.map((n) => [n.inventory_id, n.quantity_needed]));
  const nameById = new Map((items || []).filter((i) => i.inventory_id).map((i) => [i.inventory_id, i.product_type]));
  const { source = null, missing = [], shortages = [] } = evaluation || {};
  const shortfalls = [
    ...shortages.map((s) => ({
      inventory_id: s.inventory_id, item_name: s.item_name, needed: s.requested, free: s.available, shortfall: s.shortfall, missing: false
    })),
    ...missing.map((id) => ({
      inventory_id: id, item_name: nameById.get(id) || null, needed: neededById.get(id) || 0, free: 0, shortfall: neededById.get(id) || 0, missing: true
    }))
  ];
  return { needs_reservation: true, sufficient: shortfalls.length === 0, shortfalls, source };
};

module.exports = { needsReservation, stockNeeds, buildStockCheck };
</file>

<file path="Backend/services/capacity.js">
// ==========================================
// INVENTORY CAPACITY EVALUATION (Sprint 9 / PB 9)
// Shared by POST /api/inventory/check-capacity and POST /api/orders
// so the halt logic cannot be bypassed by skipping the pre-check.
// ==========================================


const { isConnectionError } = require('../utils/dbErrors');
const { ID_PATTERN } = require('../utils/validation');

// Available stock = what is on hand minus what is already promised to other orders
const computeAvailable = (row) =>
  Math.max(0, Number(row.quantity_available || 0) - Number(row.quantity_reserved || 0));

// Validates the incoming payload and merges duplicate inventory_ids
// (two lines of the same material must be checked against stock together).
const normalizeRequiredItems = (required_items) => {
  if (!Array.isArray(required_items) || required_items.length === 0) {
    return { error: 'Please add at least one material to the order.' };
  }

  const totals = new Map();

  for (let i = 0; i < required_items.length; i++) {
    const item = required_items[i] || {};
    const inventory_id = typeof item.inventory_id === 'string' ? item.inventory_id.trim() : '';
    // M7: must be a JSON number; text such as "5" is rejected
    const quantity_needed = item.quantity_needed;

    if (!inventory_id) {
      return { error: `Material ${i + 1}: please choose a material from the list.` };
    }
    if (!ID_PATTERN.test(inventory_id)) {
      return { error: `Material ${i + 1} was not recognized. Please choose it again from the list.` };
    }
    if (typeof quantity_needed !== 'number' || !Number.isInteger(quantity_needed) || quantity_needed <= 0
        || quantity_needed > 2147483647) {
      return { error: `Material ${i + 1}: the quantity must be a whole number of at least 1.` };
    }

    totals.set(inventory_id, (totals.get(inventory_id) || 0) + quantity_needed);
  }

  return {
    items: [...totals].map(([inventory_id, quantity_needed]) => ({ inventory_id, quantity_needed }))
  };
};

// Reads stock for the given IDs: Neon first, SQLite cache if the cloud is unreachable.
const fetchStockRows = async (req, inventoryIds) => {
  try {
    const result = await req.pgPool.query(
      `SELECT inventory_id, item_name, quantity_available, quantity_reserved
       FROM inventory_items
       WHERE inventory_id::text = ANY($1::text[]) AND deleted_at IS NULL AND purged_at IS NULL`,
      [inventoryIds]
    );
    return { rows: result.rows, source: 'cloud' };
  } catch (onlineError) {
    // C5: a query/schema error is NOT an outage; surface it instead of silently reading stale cache
    if (!isConnectionError(onlineError)) throw onlineError;

    console.error('Cloud DB unreachable. Checking capacity against SQLite cache:', onlineError.message);

    const placeholders = inventoryIds.map(() => '?').join(', ');
    const rows = await new Promise((resolve, reject) => {
      req.localDb.all(
        `SELECT inventory_id, item_name, quantity_available, quantity_reserved
         FROM inventory_items
         WHERE inventory_id IN (${placeholders}) AND deleted_at IS NULL AND purged_at IS NULL`,
        inventoryIds,
        (err, data) => (err ? reject(err) : resolve(data))
      );
    });
    return { rows, source: 'local' };
  }
};

// Strictly evaluates normalized items against stock.
// Throws on a non-connection cloud error, or if the cloud is down AND SQLite fails.
const evaluateCapacity = async (req, items) => {
  const { rows, source } = await fetchStockRows(req, items.map((i) => i.inventory_id));
  const stockById = new Map(rows.map((row) => [String(row.inventory_id), row]));

  const missing = [];
  const shortages = [];

  for (const item of items) {
    const row = stockById.get(item.inventory_id);
    if (!row) {
      missing.push(item.inventory_id);
      continue;
    }

    const available = computeAvailable(row);
    if (item.quantity_needed > available) {
      shortages.push({
        inventory_id: item.inventory_id,
        item_name: row.item_name,
        requested: item.quantity_needed,
        available,
        shortfall: item.quantity_needed - available
      });
    }
  }

  return { source, missing, shortages };
};

// Converts an evaluation into the HTTP error to send, or null if the order can proceed.
const capacityFailureResponse = ({ source, missing, shortages }) => {
  if (missing.length > 0) {
    return {
      status: 404,
      body: {
        error: 'INVENTORY_ITEM_NOT_FOUND',
        message: 'One or more chosen materials are no longer in the inventory (they may have been deleted). Please choose the materials again.',
        missing_inventory_ids: missing,
        source
      }
    };
  }

  if (shortages.length > 0) {
    return {
      status: 409,
      body: {
        error: 'INSUFFICIENT_INVENTORY',
        can_fulfill: false,
        message: 'There is not enough stock for this order right now.',
        shortages,
        total_shortfall: shortages.reduce((sum, s) => sum + s.shortfall, 0),
        source
      }
    };
  }

  return null;
};

module.exports = {
  computeAvailable,
  normalizeRequiredItems,
  evaluateCapacity,
  capacityFailureResponse
};
</file>

<file path="Backend/services/cloudDisabledPool.js">
// ==========================================
// OFFLINE-ONLY MODE (CLOUD_DISABLED=true, or no DATABASE_URL)
// A stand-in for the pg Pool that always answers "cloud unreachable". Every route then takes
// its normal offline path (SQLite), exactly as during an internet outage. Used by the
// automated tests and by `npm run demo`, so the system can run with no Neon account at all.
// ==========================================
const unreachable = () => Object.assign(new Error('connect ECONNREFUSED (cloud disabled: offline-only mode)'), { code: 'ECONNREFUSED' });

const createCloudDisabledPool = () => ({
  offlineOnly: true,
  query(text, params, cb) {
    const callback = typeof params === 'function' ? params : cb;
    if (callback) { setImmediate(() => callback(unreachable())); return undefined; }
    return Promise.reject(unreachable());
  },
  connect() { return Promise.reject(unreachable()); },
  on() { return this; },
  end() { return Promise.resolve(); }
});

module.exports = { createCloudDisabledPool };
</file>

<file path="Backend/services/cloudHealth.js">
// ==========================================
// CLOUD HEALTH (PB 3 / PB 4): is the cloud database reachable right now?
//
//   state  'unknown'     until the first cloud query finishes
//          'reachable'   the last cloud query worked
//          'unreachable' the last cloud query failed with a CONNECTION error (C5). Data errors
//                        (bad values, constraints) say nothing about the connection and are ignored.
//          'disabled'    offline-only mode (CLOUD_DISABLED=true or no DATABASE_URL)
//
// Signals come from watchPool(): every query the server already makes reports its outcome,
// so the routes do not change. While reachable there is NO probing at all (D3), so Neon can
// still suspend when the shop is idle. Only while unreachable does it try "SELECT 1" every
// probeMs, and the first success flips it back to reachable. onChange(next, previous) is
// called on every change; onReconnect() once per unreachable -> reachable flip.
// ==========================================
const { isConnectionError } = require('../utils/dbErrors');

// onReconnect() runs exactly once per unreachable -> reachable flip (server.js: syncAndNotify).
const createCloudHealth = ({
  pgPool, cloudDisabled = false, probeMs = 15000, onChange = () => {}, onReconnect = () => {}, now = Date.now, log = console
}) => {
  let state = cloudDisabled ? 'disabled' : 'unknown';
  let since = now();
  let timer = null;
  let probing = false;
  let probes = 0;

  const stopProbing = () => {
    if (timer) clearInterval(timer);
    timer = null;
  };

  const probe = async () => {
    if (probing || state !== 'unreachable') return;
    probing = true;
    probes += 1;
    try {
      await pgPool.query('SELECT 1');
      reportSuccess(); // eslint-disable-line no-use-before-define
    } catch (err) {
      reportFailure(err); // eslint-disable-line no-use-before-define
    } finally {
      probing = false;
    }
  };

  const startProbing = () => {
    if (timer) return;
    timer = setInterval(() => { probe(); }, probeMs);
    if (typeof timer.unref === 'function') timer.unref(); // never keeps the process alive
  };

  const setState = (next) => {
    if (state === 'disabled' || state === next) return;
    const previous = state;
    state = next;
    since = now();
    if (next === 'unreachable') startProbing();
    else stopProbing();
    if (next === 'unreachable') log.warn('☁️  Cloud database unreachable: working on this computer until it is back.');
    if (next === 'reachable' && previous === 'unreachable') log.log('☁️  Cloud database reachable again.');
    const call = (fn, ...args) => {
      try {
        const r = fn(...args);
        if (r && typeof r.catch === 'function') r.catch((err) => log.error('⚠️ Cloud health listener failed:', err.message));
      } catch (err) {
        log.error('⚠️ Cloud health listener failed:', err.message);
      }
    };
    call(onChange, next, previous);
    if (next === 'reachable' && previous === 'unreachable') call(onReconnect);
  };

  const reportSuccess = () => setState('reachable');
  const reportFailure = (err) => { if (isConnectionError(err)) setState('unreachable'); };

  return {
    state: () => state,
    since: () => since,
    probeCount: () => probes,
    reportSuccess,
    reportFailure,
    probe,
    stop: stopProbing
  };
};

// Wraps a pg Pool so every query reports to cloudHealth. Everything else passes through
// unchanged (same results, same errors, same callback/promise styles).
// Clients from connect() are wrapped per checkout, so transaction queries report too.
const watchPool = (pool, health) => {
  const track = (promise) => promise.then(
    (result) => { health.reportSuccess(); return result; },
    (err) => { health.reportFailure(err); throw err; }
  );
  const passThrough = (target, prop) => {
    const value = target[prop];
    return typeof value === 'function' ? value.bind(target) : value;
  };
  // query(text, params?, callback?) in both styles, as pg supports
  const watchedQuery = (target) => (...args) => {
    const callback = typeof args[args.length - 1] === 'function' ? args.pop() : null;
    const promise = track(Promise.resolve().then(() => target.query(...args)));
    if (!callback) return promise;
    promise.then((r) => callback(null, r), (e) => callback(e));
    return undefined;
  };
  const watchClient = (client) => new Proxy(client, {
    get: (target, prop) => (prop === 'query' ? watchedQuery(target) : passThrough(target, prop))
  });

  return new Proxy(pool, {
    get: (target, prop) => {
      if (prop === 'query') return watchedQuery(target);
      if (prop === 'connect') {
        return (...args) => {
          if (typeof args[args.length - 1] === 'function') return target.connect(...args); // callback style: untouched
          return track(target.connect(...args)).then(watchClient);
        };
      }
      return passThrough(target, prop);
    }
  });
};

module.exports = { createCloudHealth, watchPool };
</file>

<file path="Backend/services/inventoryAudit.js">
// ==========================================
// INVENTORY AUDIT TRAIL (track / trace, backend only)
// One row per catalog change, written in the SAME transaction as the change itself, so a
// change can never happen without its trace. The website never reads this table; inspect
// it with `npm run audit-log` or the Neon SQL Editor. In Neon the table is append-only.
//   actions: created | edited | stock_added | stock_subtracted | deleted | restored | purged
// details is JSON: the full item snapshot, or before/after values for edits.
// ==========================================
const crypto = require('crypto');
const { LOCAL_NOW } = require('../utils/localSync');
const { sqliteRun } = require('./records');

const SNAPSHOT_FIELDS = ['inventory_id', 'item_name', 'item_category', 'quantity_available', 'quantity_reserved',
  'minimum_threshold', 'unit_cost', 'unit', 'supplier', 'deleted_at', 'deleted_by', 'version'];

const snapshotOf = (item) =>
  Object.fromEntries(SNAPSHOT_FIELDS.filter((f) => item && item[f] !== undefined).map((f) => [f, item[f]]));

const auditValues = (actor, inventory_id, action, item_name, details) => [
  crypto.randomUUID(), inventory_id, action, item_name || null,
  details === undefined || details === null ? null : JSON.stringify(details),
  actor && actor.user_id ? String(actor.user_id) : null,
  actor && actor.role ? String(actor.role) : null
];

const auditCloud = (client, actor, inventory_id, action, item_name, details) =>
  client.query(
    `INSERT INTO inventory_audit_log (audit_id, inventory_id, action, item_name, details, performed_by, performed_role)
     VALUES ($1, $2, $3, $4, $5, $6, $7)`,
    auditValues(actor, inventory_id, action, item_name, details)
  );

// Offline: queued as pending_insert and pushed to Neon by the normal sync
const auditLocal = (tx, actor, inventory_id, action, item_name, details) =>
  sqliteRun(
    tx,
    `INSERT INTO inventory_audit_log (audit_id, inventory_id, action, item_name, details, performed_by, performed_role,
                                      created_at, sync_status, last_modified)
     VALUES (?, ?, ?, ?, ?, ?, ?, ${LOCAL_NOW}, 'pending_insert', ${LOCAL_NOW})`,
    auditValues(actor, inventory_id, action, item_name, details)
  );

// Many rows in one statement (used when purging a batch from the Recycle Bin)
const auditCloudBulk = (client, actor, action, entries) => {
  if (entries.length === 0) return Promise.resolve();
  const cols = [[], [], [], [], [], [], []];
  for (const { inventory_id, item_name, details } of entries) {
    auditValues(actor, inventory_id, action, item_name, details).forEach((v, i) => cols[i].push(v));
  }
  return client.query(
    `INSERT INTO inventory_audit_log (audit_id, inventory_id, action, item_name, details, performed_by, performed_role)
     SELECT * FROM unnest($1::text[], $2::text[], $3::text[], $4::text[], $5::text[], $6::text[], $7::text[])`,
    cols
  );
};

module.exports = { snapshotOf, auditCloud, auditLocal, auditCloudBulk };
</file>

<file path="Backend/services/inventoryEvents.js">
// ==========================================
// REAL-TIME STOCK UPDATES (Socket.io)
//
// Two sources of "stock changed":
//  1. Postgres NOTIFY 'inventory_changed' (migration 003). Fires for every committed change
//     in Neon, from ANY backend/branch, the sync service, or the SQL editor.
//  2. notifyChanged() calls from this process. Covers offline writes (Neon down, so no
//     NOTIFY) and makes the local UI instant even while the LISTEN link is reconnecting.
//
// Bursts are coalesced (DEBOUNCE_MS) into ONE 'inventory_updated' event carrying the full
// catalog snapshot (same shape as GET /api/inventory) plus the IDs that changed.
//
// Server -> client events (room 'inventory', joined on 'inventory_subscribe'):
//   inventory_updated { reason, changed_ids, snapshot }
//   inventory_live    { listening }   whether cross-branch NOTIFY is currently active
//
// LISTEN needs a session-level connection. Neon's pooled endpoint (hostname with
// "-pooler", PgBouncer transaction mode) does NOT support LISTEN, so set PG_LISTEN_URL to
// the DIRECT (non-pooled) connection string. Without it, DATABASE_URL is used if it is
// direct; with a pooled DATABASE_URL, cross-branch push is disabled (local push still works).
// ==========================================
const { Client } = require('pg');
const { buildInventorySnapshot } = require('./inventorySnapshot');
const { refreshLocalRows } = require('./sync');

const ROOM = 'inventory';
const CHANNEL = 'inventory_changed';
const DEBOUNCE_MS = 250;
const RECONNECT_MIN_MS = 2000;
const RECONNECT_MAX_MS = 60000;

const isPooledUrl = (url) => {
  try { return /-pooler\./i.test(new URL(url).hostname); } catch { return false; }
};

const createInventoryEvents = ({ io, pgPool, localDb, databaseUrl, listenUrl }) => {
  const ctx = { pgPool, localDb };
  let pendingIds = new Set();
  let pendingReasons = new Set();
  let pendingCloudIds = new Set(); // changed in Neon by anyone -> copy into local cache
  let timer = null;
  let listening = false;
  let client = null;
  let stopped = false;
  let retryMs = RECONNECT_MIN_MS;

  const flush = async () => {
    timer = null;
    const changed_ids = [...pendingIds];
    const cloudIds = [...pendingCloudIds];
    const reason = [...pendingReasons].join(',');
    pendingIds = new Set();
    pendingCloudIds = new Set();
    pendingReasons = new Set();

    // Keep the offline cache current with changes made elsewhere (always, even with no viewers)
    if (cloudIds.length > 0) {
      try {
        await refreshLocalRows(pgPool, localDb, 'inventory_items', cloudIds);
      } catch (err) {
        console.error('⚠️ Could not refresh changed inventory rows into local cache:', err.message);
      }
    }
    if (io.sockets.adapter.rooms.get(ROOM)?.size > 0) {
      try {
        const snapshot = await buildInventorySnapshot(ctx);
        io.to(ROOM).emit('inventory_updated', { reason, changed_ids, snapshot });
      } catch (err) {
        console.error('❌ Could not build inventory snapshot for push:', err.message);
      }
    }
  };

  // Call after any write that changes inventory_items (ids may be empty = "something changed")
  const notifyChanged = (ids = [], reason = 'local_write') => {
    ids.filter(Boolean).forEach((id) => pendingIds.add(id));
    pendingReasons.add(reason);
    if (!timer) timer = setTimeout(flush, DEBOUNCE_MS);
  };

  const setListening = (value) => {
    if (listening !== value) {
      listening = value;
      io.to(ROOM).emit('inventory_live', { listening });
    }
  };

  // ---------- Postgres LISTEN with automatic reconnect ----------
  const url = listenUrl || databaseUrl;
  const listenDisabledReason = !url
    ? 'no database URL'
    : (!listenUrl && isPooledUrl(databaseUrl))
      ? 'DATABASE_URL is a Neon pooled (-pooler) endpoint; set PG_LISTEN_URL to the direct connection string'
      : null;

  const scheduleReconnect = () => {
    if (stopped) return;
    setTimeout(connect, retryMs);
    retryMs = Math.min(retryMs * 2, RECONNECT_MAX_MS);
  };

  const connect = async () => {
    if (stopped) return;
    const c = new Client({ connectionString: url, ssl: { rejectUnauthorized: false }, connectionTimeoutMillis: 5000 });
    client = c;
    let failed = false;
    const onFailure = (err) => {
      if (failed) return;
      failed = true;
      // 57P01 "terminating connection due to administrator command" is Neon suspending an
      // idle compute (scale to zero). Expected and harmless: we reconnect and resync.
      if (err && err.code === '57P01') {
        console.log('ℹ️  Neon closed the idle real-time connection (auto-suspend). Reconnecting…');
      } else if (err) {
        console.error('⚠️ Inventory LISTEN connection lost:', err.message);
      }
      setListening(false);
      c.removeAllListeners();
      c.end().catch(() => {});
      scheduleReconnect();
    };
    c.on('error', onFailure);
    c.on('end', () => onFailure(null));
    c.on('notification', (msg) => {
      if (msg.channel !== CHANNEL) return;
      try {
        const id = JSON.parse(msg.payload).inventory_id;
        if (id) pendingCloudIds.add(id);
        notifyChanged([id], 'cloud_change');
      } catch {
        notifyChanged([], 'cloud_change');
      }
    });
    try {
      await c.connect();
      await c.query(`LISTEN ${CHANNEL}`);
      retryMs = RECONNECT_MIN_MS;
      setListening(true);
      console.log('📡 Listening for inventory changes in the cloud (real-time push ON)');
      // Changes may have happened while we were disconnected: push a fresh snapshot
      notifyChanged([], 'resync');
    } catch (err) {
      onFailure(err);
    }
  };

  if (listenDisabledReason) {
    console.warn(`⚠️ Cross-branch inventory push disabled: ${listenDisabledReason}. Local changes are still pushed.`);
  } else {
    connect();
  }

  // ---------- Socket wiring ----------
  const attachSocket = (socket) => {
    socket.on('inventory_subscribe', async (_data, ack) => {
      const reply = typeof ack === 'function' ? ack : () => {};
      socket.join(ROOM);
      try {
        reply({ ok: true, listening, snapshot: await buildInventorySnapshot(ctx) });
      } catch (err) {
        reply({ ok: false, listening, error: 'Could not load inventory.' });
      }
    });
    socket.on('inventory_unsubscribe', () => socket.leave(ROOM));
  };

  const stop = async () => {
    stopped = true;
    if (timer) clearTimeout(timer);
    if (client) await client.end().catch(() => {});
  };

  return { notifyChanged, attachSocket, isListening: () => listening, stop };
};

module.exports = { createInventoryEvents, isPooledUrl };
</file>

<file path="Backend/services/inventorySnapshot.js">
// ==========================================
// INVENTORY SNAPSHOT
// Single source for the catalog payload, used by GET /api/inventory AND the Socket.io
// 'inventory_updated' push, so REST and real-time clients always see the same shape.
// ==========================================
const { computeAvailable } = require('./capacity');
const { listRecords, countRecords, ACTIVE_ITEM_SQL, BIN_ITEM_SQL } = require('./records');

// Stock health, computed on the server so every screen uses the same rule:
//   out_of_stock  nothing free to use (available - reserved <= 0)
//   low_stock     free stock at or below minimum_threshold
//   in_stock      otherwise
const STOCK_STATUSES = ['in_stock', 'low_stock', 'out_of_stock'];
const stockStatusOf = (net, threshold) => {
  if (net <= 0) return 'out_of_stock';
  if (net <= threshold) return 'low_stock';
  return 'in_stock';
};

const withAvailability = (item) => {
  const net = computeAvailable(item);
  return { ...item, quantity_available_net: net, stock_status: stockStatusOf(net, item.minimum_threshold || 0) };
};

// ctx: anything with pgPool + localDb (an Express req, or { pgPool, localDb })
// -> { source, fetched_at, summary, categories, items }
const buildInventorySnapshot = async (ctx, { category, stock_status, search } = {}) => {
  // Only active items; Recycle Bin items are listed separately (paginated) and only counted here
  const { source, records } = await listRecords(ctx, 'inventory_items', { where: ACTIVE_ITEM_SQL, orderBy: 'item_name, inventory_id' });
  let recycleBin = 0;
  try {
    recycleBin = (await countRecords(ctx, 'inventory_items', { where: BIN_ITEM_SQL })).count;
  } catch (err) {
    console.error('⚠️ Could not count Recycle Bin items:', err.message);
  }
  const all = records.map(withAvailability);

  const needle = search ? search.toLowerCase() : null;
  const items = all.filter((item) =>
    (!category || item.item_category === category) &&
    (!stock_status || item.stock_status === stock_status) &&
    (!needle || item.item_name.toLowerCase().includes(needle))
  );

  const count = (status) => all.filter((i) => i.stock_status === status).length;
  return {
    source,
    fetched_at: new Date().toISOString(),
    // summary/categories describe the whole catalog, not the filtered list
    summary: {
      total_items: all.length,
      in_stock: count('in_stock'),
      low_stock: count('low_stock'),
      out_of_stock: count('out_of_stock'),
      unsynced: all.filter((i) => i.sync_status !== 'synced').length,
      recycle_bin: recycleBin,
      stock_value: Math.round(all.reduce((sum, i) => sum + i.quantity_available * i.unit_cost, 0) * 100) / 100
    },
    categories: [...new Set(all.map((i) => i.item_category))].sort(),
    items
  };
};

module.exports = { STOCK_STATUSES, stockStatusOf, withAvailability, buildInventorySnapshot };
</file>

<file path="Backend/services/localSchema.js">
// ==========================================
// LOCAL (SQLite) SCHEMA
// Creates the offline-cache tables. Runs automatically every time the server starts, so a
// fresh or deleted local_cache.db never causes "no such table" sync errors. Safe to run
// repeatedly (CREATE ... IF NOT EXISTS). Columns added later are back-filled on existing
// databases by ensureLocalSyncColumns() in utils/localSync.js.
// ==========================================

const sqlite3 = require('sqlite3');
const { PRODUCTION_STATUSES } = require('../utils/validation');

const SYNC_STATUS = `sync_status TEXT DEFAULT 'synced' CHECK (sync_status IN ('synced', 'pending_insert', 'pending_update'))`;
// Same allow-list as Neon (migration 005) and the API validator
const ORDER_STATUS_SQL = PRODUCTION_STATUSES.map((s) => `'${s}'`).join(', ');

const LOCAL_TABLES = [
  `CREATE TABLE IF NOT EXISTS inventory_items (
      inventory_id TEXT PRIMARY KEY,
      item_name TEXT NOT NULL,
      item_category TEXT NOT NULL,
      quantity_available INTEGER NOT NULL DEFAULT 0,
      quantity_reserved INTEGER NOT NULL DEFAULT 0,
      minimum_threshold INTEGER NOT NULL DEFAULT 0,
      unit_cost REAL NOT NULL,
      unit TEXT NOT NULL DEFAULT 'pcs',
      supplier TEXT,
      deleted_at TEXT,
      deleted_by TEXT,
      purged_at TEXT,
      ${SYNC_STATUS},
      last_modified DATETIME DEFAULT CURRENT_TIMESTAMP,
      CHECK (quantity_reserved >= 0 AND quantity_available >= 0)
  )`,
  `CREATE TABLE IF NOT EXISTS users (
      user_id TEXT PRIMARY KEY,
      username TEXT UNIQUE NOT NULL,
      password_hash TEXT NOT NULL,
      role TEXT NOT NULL CHECK (role IN ('Owner', 'Admin', 'Production', 'Staff')),
      is_active INTEGER NOT NULL DEFAULT 1,
      tokens_valid_after TEXT,
      ${SYNC_STATUS},
      last_modified DATETIME DEFAULT CURRENT_TIMESTAMP,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS customers (
      customer_id TEXT PRIMARY KEY,
      full_name TEXT NOT NULL,
      contact_number TEXT,
      platform_source TEXT,
      ${SYNC_STATUS},
      last_modified DATETIME DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS order_profiles (
      order_id TEXT PRIMARY KEY,
      customer_id TEXT REFERENCES customers(customer_id) ON DELETE RESTRICT,
      date_created DATETIME DEFAULT CURRENT_TIMESTAMP,
      production_deadline DATETIME NOT NULL,
      production_status TEXT DEFAULT 'Pending' CHECK (production_status IN (${ORDER_STATUS_SQL})),
      design_drive_link TEXT,
      total_quote_amount REAL DEFAULT 0.00,
      stock_reserved INTEGER NOT NULL DEFAULT 0,
      approved_by TEXT,
      approved_at TEXT,
      tracking_no TEXT,
      ${SYNC_STATUS},
      last_modified DATETIME DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS order_items (
      line_item_id TEXT PRIMARY KEY,
      order_id TEXT REFERENCES order_profiles(order_id) ON DELETE CASCADE,
      inventory_id TEXT REFERENCES inventory_items(inventory_id) ON DELETE RESTRICT,
      product_type TEXT NOT NULL,
      quantity INTEGER NOT NULL,
      size TEXT,
      custom_name TEXT,
      custom_number TEXT,
      price REAL DEFAULT 0.00,
      ${SYNC_STATUS},
      last_modified DATETIME DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS payments (
      payment_id TEXT PRIMARY KEY,
      order_id TEXT REFERENCES order_profiles(order_id) ON DELETE CASCADE,
      amount REAL NOT NULL,
      payment_date DATETIME DEFAULT CURRENT_TIMESTAMP,
      payment_type TEXT NOT NULL CHECK (payment_type IN ('Cash', 'GCash', 'Bank Transfer')),
      received_by TEXT,
      receipt_no TEXT,
      ${SYNC_STATUS},
      last_modified DATETIME DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS material_loss (
      loss_id TEXT PRIMARY KEY,
      order_id TEXT REFERENCES order_profiles(order_id) ON DELETE SET NULL,
      inventory_id TEXT REFERENCES inventory_items(inventory_id) ON DELETE RESTRICT,
      quantity_lost INTEGER NOT NULL,
      loss_reason TEXT NOT NULL,
      date_recorded DATETIME DEFAULT CURRENT_TIMESTAMP,
      financial_cost REAL NOT NULL DEFAULT 0.00,
      ${SYNC_STATUS},
      last_modified DATETIME DEFAULT CURRENT_TIMESTAMP
  )`,
  // Backend-only trace of every catalog change (never shown on the website). No foreign key,
  // so the trace survives even after an item is permanently deleted.
  `CREATE TABLE IF NOT EXISTS inventory_audit_log (
      audit_id TEXT PRIMARY KEY,
      inventory_id TEXT NOT NULL,
      action TEXT NOT NULL,
      item_name TEXT,
      details TEXT,
      performed_by TEXT,
      performed_role TEXT,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      ${SYNC_STATUS},
      last_modified DATETIME DEFAULT CURRENT_TIMESTAMP
  )`,
  // Sessions ended with "Log out" on one device (migration 007). Rows written while offline
  // are pending_insert and pushed by the sync; no foreign key, like the audit trail.
  `CREATE TABLE IF NOT EXISTS revoked_sessions (
      session_id TEXT PRIMARY KEY,
      user_id TEXT NOT NULL,
      expires_at TEXT NOT NULL,
      revoked_at TEXT,
      ${SYNC_STATUS},
      last_modified DATETIME DEFAULT CURRENT_TIMESTAMP
  )`,
  'CREATE INDEX IF NOT EXISTS idx_local_inventory_bin ON inventory_items (deleted_at)',
  'CREATE INDEX IF NOT EXISTS idx_local_audit_item ON inventory_audit_log (inventory_id, created_at)',
  'CREATE INDEX IF NOT EXISTS idx_local_order_tracking ON order_profiles (tracking_no)',
  'CREATE INDEX IF NOT EXISTS idx_local_payments_order ON payments (order_id)'
];

const run = (db, sql) => new Promise((resolve, reject) => db.run(sql, (err) => (err ? reject(err) : resolve())));
const all = (db, sql) => new Promise((resolve, reject) => db.all(sql, (err, rows) => (err ? reject(err) : resolve(rows))));

// Indexes on columns that an older local_cache.db may not have yet are created after
// ensureLocalSyncColumns() back-fills them, so they are retried there.
const createLocalSchema = async (db) => {
  for (const sql of LOCAL_TABLES) {
    try {
      await run(db, sql);
    } catch (err) {
      if (/^CREATE INDEX/.test(sql) && /no such column/i.test(err.message)) continue;
      throw err;
    }
  }
};

const createLocalIndexes = async (db) => {
  for (const sql of LOCAL_TABLES.filter((s) => s.startsWith('CREATE INDEX'))) await run(db, sql);
};

const listLocalTables = async (db) =>
  (await all(db, "SELECT name FROM sqlite_master WHERE type = 'table'")).map((r) => r.name);

// Sprint 11 / PB 13: a cache created before 'Approved' existed still has the old
// production_status CHECK, so copying an approved order from Neon would fail. SQLite cannot
// ALTER a CHECK, so the table is rebuilt once, keeping every row and column (including
// unsynced offline rows): the new definition is the stored one with only the status list
// replaced, and rows are copied with SELECT * (same column order).
// Runs on its own connection so PRAGMA foreign_keys = OFF (needed so DROP TABLE does not
// cascade into order_items / payments) never affects the server's shared connection.
// -> true if the table was rebuilt, false if nothing had to change
const upgradeLocalOrderStatusCheck = (dbPath) => new Promise((resolve, reject) => {
  const db = new sqlite3.Database(dbPath, async (openErr) => {
    if (openErr) return reject(openErr);
    db.configure('busyTimeout', 5000);
    const get = (sql) => new Promise((ok, fail) => db.get(sql, (err, row) => (err ? fail(err) : ok(row))));
    let began = false;
    try {
      const table = await get("SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'order_profiles'");
      const check = table && /production_status\s+IN\s*\([^)]*\)/i.exec(table.sql);
      if (!check || check[0].includes("'Approved'")) return resolve(false);

      const newSql = table.sql
        .replace(/CREATE TABLE\s+(IF NOT EXISTS\s+)?["`]?order_profiles["`]?/i, 'CREATE TABLE order_profiles__upgrade')
        .replace(check[0], `production_status IN (${ORDER_STATUS_SQL})`);
      if (!newSql.startsWith('CREATE TABLE order_profiles__upgrade')) {
        throw new Error('unrecognised order_profiles definition');
      }

      await run(db, 'PRAGMA foreign_keys = OFF'); // has no effect inside a transaction, so set first
      await run(db, 'BEGIN IMMEDIATE');
      began = true;
      await run(db, 'DROP TABLE IF EXISTS order_profiles__upgrade');
      await run(db, newSql);
      await run(db, 'INSERT INTO order_profiles__upgrade SELECT * FROM order_profiles');
      const [before, after] = await Promise.all([
        get('SELECT COUNT(*) AS n FROM order_profiles'), get('SELECT COUNT(*) AS n FROM order_profiles__upgrade')
      ]);
      if (before.n !== after.n) throw new Error(`row count mismatch (${before.n} vs ${after.n})`);
      await run(db, 'DROP TABLE order_profiles');
      await run(db, 'ALTER TABLE order_profiles__upgrade RENAME TO order_profiles');
      await run(db, 'COMMIT');
      console.log(`🛠  Local order_profiles upgraded for the 'Approved' status (${after.n} row(s) kept)`);
      resolve(true);
    } catch (err) {
      if (began) await run(db, 'ROLLBACK').catch(() => {});
      reject(new Error(`Could not upgrade local order_profiles: ${err.message}`));
    } finally {
      db.close();
    }
  });
});

module.exports = { createLocalSchema, createLocalIndexes, listLocalTables, upgradeLocalOrderStatusCheck };
</file>

<file path="Backend/services/migrations.js">
// ==========================================
// NEON MIGRATION RUNNER (shared by `npm run migrate` and server start-up)
// Applies every migrations/*.sql file not yet recorded in schema_migrations, in filename
// order, each in its own transaction. A transaction-level advisory lock means two servers
// starting at the same time never apply the same file twice (works on Neon's pooler too).
// Every migration file is idempotent, so re-running one that was pasted by hand is safe.
// ==========================================
const fs = require('fs');
const path = require('path');

const MIGRATIONS_DIR = path.resolve(__dirname, '..', 'migrations');
const MIGRATION_LOCK_KEY = 74_201_004;

const listMigrationFiles = () => fs.readdirSync(MIGRATIONS_DIR).filter((f) => f.endsWith('.sql')).sort();

const ensureMigrationsTable = (client) => client.query(`
  CREATE TABLE IF NOT EXISTS schema_migrations (
    filename   VARCHAR(255) PRIMARY KEY,
    applied_at TIMESTAMP NOT NULL DEFAULT NOW()
  )`);

const appliedSet = async (client) =>
  new Set((await client.query('SELECT filename FROM schema_migrations')).rows.map((r) => r.filename));

// -> { applied: [...files applied now], pending: [...] }
const applyPendingMigrations = async (pool, { log = console.log } = {}) => {
  const client = await pool.connect();
  const appliedNow = [];
  try {
    await ensureMigrationsTable(client);
    const already = await appliedSet(client);
    for (const file of listMigrationFiles().filter((f) => !already.has(f))) {
      const sql = fs.readFileSync(path.join(MIGRATIONS_DIR, file), 'utf8');
      try {
        await client.query('BEGIN');
        await client.query('SELECT pg_advisory_xact_lock($1)', [MIGRATION_LOCK_KEY]);
        // Another server may have applied it while we waited for the lock
        const done = await client.query('SELECT 1 FROM schema_migrations WHERE filename = $1', [file]);
        if (done.rowCount === 0) {
          await client.query(sql);
          await client.query('INSERT INTO schema_migrations (filename) VALUES ($1)', [file]);
          appliedNow.push(file);
        }
        await client.query('COMMIT');
        if (done.rowCount === 0) log(`✅ Applied migration ${file}`);
      } catch (err) {
        await client.query('ROLLBACK').catch(() => {});
        throw Object.assign(new Error(`${file} failed and was rolled back: ${err.message}`), { code: err.code });
      }
    }
    return { applied: appliedNow };
  } finally {
    client.release();
  }
};

const migrationStatus = async (pool) => {
  const client = await pool.connect();
  try {
    await ensureMigrationsTable(client);
    const applied = await appliedSet(client);
    return listMigrationFiles().map((file) => ({ file, applied: applied.has(file) }));
  } finally {
    client.release();
  }
};

module.exports = { applyPendingMigrations, migrationStatus };
