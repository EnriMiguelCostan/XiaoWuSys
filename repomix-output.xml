<file path="Backend/tests/payments-sync.test.js">
// PB 21 + D2 with the sync engine. Two branches take payments for the same order while the
// internet is down. Each branch checks the balance against its own copy, so together they
// can overpay. When they sync, the cloud accepts every payment (sync never drops one), gives
// each its AR-YYYY-NNNN receipt number, and the order shows "Overpaid" for the Owner.
// The cloud is a small scripted stand-in that records every query; the real receipt-number
// trigger and the real balance lock are tested on PostgreSQL in payments.pg.test.js.
const { describe, it, before, after } = require('node:test');
const assert = require('node:assert/strict');
const fs = require('fs');
const os = require('os');
const path = require('path');
const { prepareDatabase, startTestServer } = require('./helpers/testServer');
const { syncOfflineData, getLastSync } = require('../services/sync');
const { sqliteRun, sqliteAll } = require('../services/records');

const flat = (sql) => sql.replace(/\s+/g, ' ').trim();
const unreachable = () => Object.assign(new Error('connect ECONNREFUSED 127.0.0.1:5432'), { code: 'ECONNREFUSED' });

const createScriptedCloud = () => {
  const queries = [];
  const payments = new Map(); // payment_id -> row, as the cloud stores it
  let receiptCounter = 0;
  const cloud = {
    offline: true,
    queries,
    payments,
    query: async (sql, params = []) => {
      if (cloud.offline) throw unreachable();
      const q = flat(sql);
      queries.push({ q, params });
      if (/^SELECT 1 FROM payments WHERE payment_id = \$1$/.test(q)) return { rows: [], rowCount: payments.has(params[0]) ? 1 : 0 };
      const insert = /^INSERT INTO payments \(([^)]+)\)/.exec(q);
      if (insert) {
        const cols = insert[1].split(',').map((c) => c.trim()).filter((c) => c !== 'last_modified');
        const row = Object.fromEntries(cols.map((c, i) => [c, params[i]]));
        // What the migration 008 trigger does: the cloud gives the number, whatever was sent
        row.receipt_no = `AR-2026-${String(++receiptCounter).padStart(4, '0')}`;
        payments.set(row.payment_id, row);
        return { rows: [], rowCount: 1 };
      }
      if (/^INSERT INTO /.test(q)) return { rows: [], rowCount: 1 };
      if (/AS version, receipt_no::text AS receipt_no FROM payments WHERE payment_id = \$1$/.test(q)) {
        const row = payments.get(params[0]);
        return { rows: [{ version: '2026-10-30T08:00:00.000001', receipt_no: row ? row.receipt_no : null }], rowCount: 1 };
      }
      if (/^SELECT payment_id::text AS payment_id, .* FROM payments$/.test(q)) {
        // Refresh: every branch's payments come back down to this computer
        return {
          rows: [...payments.values()].map((p) => ({
            payment_id: p.payment_id, order_id: p.order_id, amount: String(p.amount), payment_date: String(p.payment_date),
            payment_type: p.payment_type, received_by: p.received_by || null, receipt_no: p.receipt_no, version: '2026-10-30T08:00:00.000001'
          })),
          rowCount: payments.size
        };
      }
      if (/AS version FROM \w+ WHERE \w+ = \$1$/.test(q)) return { rows: [{ version: '2026-10-30T08:00:00.000001' }], rowCount: 1 };
      return { rows: [], rowCount: 0 }; // other refresh reads: nothing new
    },
    connect: async () => {
      if (cloud.offline) throw unreachable();
      throw new Error('not used');
    }
  };
  return cloud;
};

// A branch computer: its own SQLite copy that already has the customer and the priced order
const prepareBranch = async (dir, name) => {
  const file = path.join(dir, `${name}.db`);
  const db = await prepareDatabase(file);
  await sqliteRun(db, "INSERT INTO customers (customer_id, full_name, sync_status) VALUES ('c-1', 'Agdao NHS', 'synced')");
  await sqliteRun(db,
    `INSERT INTO order_profiles (order_id, customer_id, production_deadline, production_status, total_quote_amount, tracking_no, sync_status, cloud_last_modified)
     VALUES ('o-1', 'c-1', '2026-11-10T00:00:00', 'Approved', 1000, 'XM-2026-0042', 'synced', '2026-10-29T08:00:00.000001')`);
  await new Promise((r) => db.close(r));
  return file;
};

describe('Sync: offline payments from two branches', () => {
  let dir;
  let cloud;
  let branchA;
  let branchB;

  before(async () => {
    dir = fs.mkdtempSync(path.join(os.tmpdir(), 'xiaowusys-paysync-'));
    cloud = createScriptedCloud();
    branchA = await startTestServer({ dbPath: await prepareBranch(dir, 'branch-a'), pgPool: cloud });
    branchB = await startTestServer({ dbPath: await prepareBranch(dir, 'branch-b'), pgPool: cloud });
    await branchA.login('production');
    await branchB.login('admin');
  });
  after(async () => {
    await branchA.close();
    await branchB.close();
    fs.rmSync(dir, { recursive: true, force: true });
  });

  it('lets each branch take a payment within its own copy of the balance while offline', async () => {
    const a = await branchA.request('POST', '/api/orders/o-1/payments', { token: branchA.tokens.production, body: { amount: 800, payment_type: 'Cash' } });
    assert.equal(a.status, 201, a.text);
    assert.equal(a.body.source, 'local');
    const b = await branchB.request('POST', '/api/orders/o-1/payments', { token: branchB.tokens.admin, body: { amount: 700, payment_type: 'GCash' } });
    assert.equal(b.status, 201, b.text);
    const tooMuch = await branchA.request('POST', '/api/orders/o-1/payments', { token: branchA.tokens.production, body: { amount: 200.01, payment_type: 'Cash' } });
    assert.equal(tooMuch.status, 409, 'offline, the cap still applies to what this branch can see');
    assert.equal(tooMuch.body.remaining, 200);
  });

  it('pushes the payments with no balance cap and no receipt number, and saves the number the cloud gave', async () => {
    cloud.offline = false;
    const summary = await syncOfflineData(cloud, branchA.localDb);
    assert.equal(summary.aborted, false);
    const insert = cloud.queries.find((x) => x.q.startsWith('INSERT INTO payments'));
    assert.ok(insert, 'the payment was pushed');
    assert.ok(!/receipt_no/.test(insert.q), 'this computer never sends a receipt number');
    assert.ok(!/WHERE|SELECT/.test(insert.q), 'no balance check on sync: a payment is never dropped');
    assert.match(insert.q, /\(payment_id, order_id, amount, payment_date, payment_type, received_by, last_modified\)/);
    assert.ok(insert.params.includes('u-production'), 'the receiver is pushed');
    assert.ok(cloud.queries.some((x) => /^SELECT 1 FROM payments WHERE payment_id = \$1$/.test(x.q)),
      'checks first, so a payment that is already in the cloud never uses up a number');

    const [row] = await sqliteAll(branchA.localDb, "SELECT receipt_no, sync_status, received_by FROM payments WHERE order_id = 'o-1'");
    assert.deepEqual([row.receipt_no, row.sync_status, row.received_by], ['AR-2026-0001', 'synced', 'u-production']);
    assert.equal(getLastSync().result, 'ok');
    assert.ok(getLastSync().at);
  });

  it('accepts the other branch too, so the order shows Overpaid for the Owner to refund', async () => {
    const summary = await syncOfflineData(cloud, branchB.localDb);
    assert.deepEqual([summary.aborted, summary.failed], [false, 0]);
    assert.equal(cloud.payments.size, 2, 'both payments are in the cloud');

    cloud.offline = true; // read branch B's copy, which the sync refreshed with branch A's payment
    const d = await branchB.request('GET', '/api/orders/o-1', { token: branchB.tokens.admin });
    assert.equal(d.status, 200, d.text);
    assert.deepEqual(d.body.payments.map((p) => [p.amount, p.receipt_no, p.sync_status]).sort(),
      [[700, 'AR-2026-0002', 'synced'], [800, 'AR-2026-0001', 'synced']]);
    assert.deepEqual([d.body.totals.payment_status, d.body.totals.total_paid, d.body.totals.overpaid_by, d.body.totals.remaining],
      ['Overpaid', 1500, 500, 0]);
    assert.equal(d.body.allowed_actions.record_payment, false);
  });

  it('does not count an aborted run as a sync', async () => {
    const before = getLastSync();
    await sqliteRun(branchA.localDb,
      "INSERT INTO payments (payment_id, order_id, amount, payment_type, sync_status) VALUES ('p-late', 'o-1', 1, 'Cash', 'pending_insert')");
    const summary = await syncOfflineData(cloud, branchA.localDb); // cloud still offline
    assert.equal(summary.aborted, true);
    assert.deepEqual(getLastSync(), { at: before.at, result: 'aborted' });
  });
});
</file>

<file path="Backend/tests/payments.pg.test.js">
// ==========================================
// PAYMENTS ON A REAL POSTGRESQL DATABASE (PB 21, migration 008)
// Runs only when TEST_DATABASE_URL is set (CI starts a throw-away PostgreSQL for it). The
// database is WIPED first: localhost or a database whose name contains "test" only, never Neon.
//
// Checks: migration 008 applies and is safe to run twice; existing payments are numbered
// AR-YYYY-NNNN oldest first per shop-time year; a rolled-back payment leaves no gap and a
// number never changes; two payments sent at the same moment through the real route never
// add up to more than the balance; and the start-up schema check finds the new trigger.
// ==========================================
const { describe, it, before, after } = require('node:test');
const assert = require('node:assert/strict');
const { pgTarget, resetDatabase, startPgTestServer, readMigration } = require('./helpers/pgTestServer');

const { url, skip } = pgTarget();

describe('Payments and receipt numbers on real PostgreSQL', { skip }, () => {
  let pool;
  let server;
  let production;

  const insertPayment = (client, id, paidAt, { amount = 100, order = 'o-legacy', legacy = false, receiver = null } = {}) => client.query(
    legacy
      ? `INSERT INTO payments (payment_id, order_id, amount, payment_type, payment_date) VALUES ($1, $2, $3, 'Cash', $4)`
      : `INSERT INTO payments (payment_id, order_id, amount, payment_type, payment_date, received_by)
         VALUES ($1, $2, $3, 'Cash', $4, $5) RETURNING receipt_no`,
    legacy ? [id, order, amount, paidAt] : [id, order, amount, paidAt, receiver]);
  const numbers = async () => Object.fromEntries((await pool.query(
    'SELECT payment_id, receipt_no FROM payments ORDER BY payment_id')).rows.map((r) => [r.payment_id, r.receipt_no]));
  const insertOrder = (id, quote, status = 'Pending') => pool.query(
    `INSERT INTO order_profiles (order_id, customer_id, production_deadline, production_status, total_quote_amount)
     VALUES ($1, 'c-1', '2030-12-31 00:00:00', $2, $3)`, [id, status, quote]);
  const pay = (orderId, amount, token = production) =>
    server.request('POST', `/api/orders/${orderId}/payments`, { token, body: { amount, payment_type: 'Cash' } });

  before(async () => {
    const { Pool } = require('pg'); // only needed when this suite runs
    pool = new Pool({ connectionString: url, max: 8 });
    // An existing shop database: everything up to 007, with payments already in it
    await resetDatabase(pool, { before: '008' });
    await pool.query("INSERT INTO users (user_id, username, password_hash, role) VALUES ('u-owner', 'owner', 'x', 'Owner'), ('u-production', 'production', 'x', 'Production')");
    await pool.query("INSERT INTO customers (customer_id, full_name) VALUES ('c-1', 'Agdao NHS')");
    await insertOrder('o-legacy', 100000);
    // payment_date is UTC; the shop (Asia/Manila) is 8 hours ahead
    await insertPayment(pool, 'p-mar', '2026-03-01 00:00:00', { legacy: true });
    await insertPayment(pool, 'p-jan', '2026-01-15 00:00:00', { legacy: true });
    await insertPayment(pool, 'p-dec31', '2025-12-31 15:59:59', { legacy: true }); // 23:59:59 in Manila: still 2025
    await insertPayment(pool, 'p-newyear', '2025-12-31 16:00:00', { legacy: true }); // 00:00 Jan 1 in Manila: 2026
  });
  after(async () => {
    if (server) await server.close();
    if (pool) await pool.end();
  });

  it('applies migration 008, and running it again changes nothing', async () => {
    const { applyPendingMigrations } = require('../services/migrations');
    const first = await applyPendingMigrations(pool, { log: () => {} });
    assert.ok(first.applied.includes('008_payments_receipts.sql'), JSON.stringify(first.applied));
    const snapshot = await numbers();
    assert.deepEqual((await applyPendingMigrations(pool, { log: () => {} })).applied, []);
    await pool.query(readMigration('008_payments_receipts.sql')); // pasted again by hand
    assert.deepEqual(await numbers(), snapshot);
  });

  it('numbers existing payments oldest first, per shop-time year', async () => {
    assert.deepEqual(await numbers(), {
      'p-dec31': 'AR-2025-0001',
      'p-jan': 'AR-2026-0002',
      'p-mar': 'AR-2026-0003',
      'p-newyear': 'AR-2026-0001'
    });
    const legacy = await pool.query("SELECT received_by FROM payments WHERE payment_id = 'p-jan'");
    assert.equal(legacy.rows[0].received_by, null, 'older payments have no receiver ("Not recorded")');
  });

  it('gives a new payment the next number, replaces a typed one, and never changes it afterwards', async () => {
    assert.equal((await insertPayment(pool, 'p-jun', '2026-06-01 02:00:00', { receiver: 'u-production' })).rows[0].receipt_no, 'AR-2026-0004');
    const typed = await pool.query(
      `INSERT INTO payments (payment_id, order_id, amount, payment_type, payment_date, receipt_no)
       VALUES ('p-typed', 'o-legacy', 1, 'Cash', '2027-02-01 02:00:00', 'AR-1999-9999') RETURNING receipt_no`);
    assert.equal(typed.rows[0].receipt_no, 'AR-2027-0001', 'a number sent by a client is replaced');
    await pool.query("UPDATE payments SET receipt_no = 'AR-2026-9999', payment_type = 'GCash' WHERE payment_id = 'p-jun'");
    const r = await pool.query("SELECT receipt_no, payment_type FROM payments WHERE payment_id = 'p-jun'");
    assert.deepEqual([r.rows[0].receipt_no, r.rows[0].payment_type], ['AR-2026-0004', 'GCash']);
  });

  it('leaves no gap when saving a payment is rolled back', async () => {
    const client = await pool.connect();
    try {
      await client.query('BEGIN');
      await insertPayment(client, 'p-rolled-back', '2026-07-01 02:00:00');
      await client.query('ROLLBACK');
    } finally { client.release(); }
    assert.equal((await insertPayment(pool, 'p-after', '2026-07-01 03:00:00')).rows[0].receipt_no, 'AR-2026-0005');
  });

  it('only accepts a receiver that is a real account', async () => {
    await assert.rejects(insertPayment(pool, 'p-ghost', '2026-07-02 03:00:00', { receiver: 'ghost' }), { code: '23503' });
  });

  it('records a payment online with its receipt number, receiver and fresh totals', async () => {
    server = await startPgTestServer(pool);
    production = server.tokenFor('u-production', 'Production');
    await insertOrder('o-online', 1000);
    const r = await pay('o-online', 100);
    assert.equal(r.status, 201, r.text);
    assert.equal(r.body.source, 'cloud');
    assert.match(r.body.payment.receipt_no, /^AR-\d{4}-\d{4}$/);
    assert.deepEqual([r.body.payment.received_by, r.body.payment.received_by_name], ['u-production', 'production']);
    assert.deepEqual([r.body.totals.payment_status, r.body.totals.remaining, r.body.totals.downpayment.paid_synced], ['Partial', 900, 100]);
    assert.deepEqual(r.body.warnings.map((w) => w.code), ['DOWNPAYMENT_SHORT']);

    const over = await pay('o-online', 900.01);
    assert.deepEqual([over.status, over.body.error, over.body.remaining], [409, 'PAYMENT_EXCEEDS_BALANCE', 900]);

    await insertOrder('o-cancelled', 500, 'Cancelled');
    assert.equal((await pay('o-cancelled', 1)).body.error, 'ORDER_CLOSED');
    await insertOrder('o-unpriced', 0);
    assert.equal((await pay('o-unpriced', 1)).status, 422);
    const done = await insertOrder('o-done', 300, 'Completed').then(() => pay('o-done', 300));
    assert.equal(done.status, 201, 'the final balance can be paid at pickup');
  });

  it('never lets two payments sent at the same moment add up to more than the balance', async () => {
    for (let round = 0; round < 3; round++) {
      const orderId = `o-race-${round}`;
      await insertOrder(orderId, 1000);
      // Hold the order row so both requests are waiting on it at the same time
      const blocker = await pool.connect();
      try {
        await blocker.query('BEGIN');
        await blocker.query('SELECT 1 FROM order_profiles WHERE order_id = $1 FOR UPDATE', [orderId]);
        const both = Promise.all([pay(orderId, 600), pay(orderId, 600)]);
        await new Promise((r) => setTimeout(r, 300));
        await blocker.query('COMMIT');
        const results = await both;
        assert.deepEqual(results.map((x) => x.status).sort(), [201, 409], results.map((x) => x.text).join('\n'));
        const refused = results.find((x) => x.status === 409);
        assert.deepEqual([refused.body.error, refused.body.remaining], ['PAYMENT_EXCEEDS_BALANCE', 400]);
      } finally { blocker.release(); }
      const total = await pool.query('SELECT SUM(amount)::text AS s, COUNT(*)::int AS n FROM payments WHERE order_id = $1', [orderId]);
      assert.deepEqual([total.rows[0].s, total.rows[0].n], ['600.00', 1]);
    }
  });

  it('passes the start-up schema check, including the receipt-number trigger', async () => {
    const { checkCloudSchema } = require('../services/schemaCheck');
    const original = console.error;
    console.error = () => {};
    try {
      const result = await checkCloudSchema(pool);
      assert.deepEqual([result.ok, result.missing, result.missingTriggers], [true, [], []]);
    } finally { console.error = original; }
  });
});
</file>

<file path="Backend/tests/payments.test.js">
// PB 21 (payments) and PB 3 / PB 4 (sync queue) on this computer's database, cloud switched off.
// Every payment here takes the real offline path: the same checks as online, against the
// local copy, including payments that are still waiting to sync.
const { describe, it, before, after } = require('node:test');
const assert = require('node:assert/strict');
const { startTestServer, shopDate, fixtures } = require('./helpers/testServer');

describe('Payments: balance limit, receiver and payment status', () => {
  let t;
  let shirt;
  let customer;
  const orders = {};

  const pay = (orderId, amount, who = 'production', extra = {}) =>
    t.request('POST', `/api/orders/${orderId}/payments`, { token: t.tokens[who], body: { amount, payment_type: 'Cash', ...extra } });
  const paymentCount = async (orderId) => (await t.get('SELECT COUNT(*) AS n FROM payments WHERE order_id = ?', [orderId])).n;
  const newOrder = async (quote, body = {}) => {
    const r = await t.request('POST', '/api/orders', {
      token: t.tokens.owner,
      body: { customer_id: customer, production_deadline: shopDate(7), total_quote_amount: quote,
        required_items: [{ inventory_id: shirt, quantity_needed: 1 }], ...body }
    });
    assert.equal(r.status, 201, r.text);
    return r.body.order_id;
  };

  before(async () => {
    t = await startTestServer();
    for (const who of ['owner', 'admin', 'production', 'staff']) await t.login(who);
    shirt = (await t.request('POST', '/api/inventory', { token: t.tokens.owner, body: fixtures.ITEMS[0] })).body.item.inventory_id;
    customer = (await t.request('POST', '/api/customers', { token: t.tokens.owner, body: fixtures.CUSTOMERS[0] })).body.customer.customer_id;
    orders.main = await newOrder(1000);
    orders.odd = await newOrder(999.99);
    orders.noQuote = await newOrder(0);
    orders.cancelled = await newOrder(500, { resolution: 'Cancelled' }); // lost sale logged at creation
  });
  after(async () => { await t.close(); });

  it('refuses a payment above the remaining balance, and saves nothing', async () => {
    const r = await pay(orders.main, 1000.01);
    assert.equal(r.status, 409, r.text);
    assert.equal(r.body.error, 'PAYMENT_EXCEEDS_BALANCE');
    assert.equal(r.body.message, 'The most this order can take now is ₱1,000.00 (the remaining balance).');
    assert.deepEqual([r.body.remaining, r.body.total_paid, r.body.total_quote_amount], [1000, 0, 1000]);
    assert.equal(await paymentCount(orders.main), 0);
  });

  it('shows Partial after part of the price, and Fully Paid when the balance is paid exactly', async () => {
    let r = await pay(orders.main, 300);
    assert.equal(r.status, 201, r.text);
    assert.deepEqual([r.body.totals.payment_status, r.body.totals.remaining, r.body.totals.total_paid], ['Partial', 700, 300]);
    assert.equal(r.body.allowed_actions.max_payment, 700, 'the form can be limited to what is left');

    const over = await pay(orders.main, 700.01);
    assert.equal(over.status, 409);
    assert.equal(over.body.remaining, 700);

    r = await pay(orders.main, 700);
    assert.equal(r.status, 201, r.text);
    assert.deepEqual([r.body.totals.payment_status, r.body.totals.remaining, r.body.totals.overpaid_by], ['Fully Paid', 0, 0]);
    assert.equal(r.body.allowed_actions.record_payment, false);
    assert.equal(r.body.allowed_actions.payment_blocked_reason, 'This order is fully paid.');

    const more = await pay(orders.main, 0.01);
    assert.equal(more.status, 409);
    assert.equal(more.body.message, 'This order is already fully paid, so no more payments can be added.');
  });

  it('counts centavos exactly (a ₱999.99 quote)', async () => {
    let r = await pay(orders.odd, 499.99);
    assert.equal(r.status, 201, r.text);
    assert.deepEqual([r.body.totals.payment_status, r.body.totals.remaining], ['Partial', 500]);
    assert.equal(r.body.totals.downpayment.required, 500, '50% of ₱999.99 rounds up to ₱500.00');
    assert.equal((await pay(orders.odd, 500.01)).status, 409);
    r = await pay(orders.odd, 500);
    assert.deepEqual([r.status, r.body.totals.payment_status, r.body.totals.total_paid], [201, 'Fully Paid', 999.99]);
  });

  it('refuses payments on a cancelled order, or before the Owner sets the price, and from Staff', async () => {
    const closed = await pay(orders.cancelled, 100);
    assert.deepEqual([closed.status, closed.body.error], [409, 'ORDER_CLOSED']);
    const noQuote = await pay(orders.noQuote, 100);
    assert.deepEqual([noQuote.status, noQuote.body.error], [422, 'QUOTE_REQUIRED']);
    assert.match(noQuote.body.message, /Ask the Owner to set the quote/);
    const staff = await pay(orders.odd, 1, 'staff');
    assert.equal(staff.status, 403);
    for (const id of [orders.cancelled, orders.noQuote]) assert.equal(await paymentCount(id), 0);
  });

  it('records who received the payment from the login, never from the request', async () => {
    const forOrder = await newOrder(2000);
    for (const extra of [{ received_by: 'u-owner' }, { receipt_no: 'AR-2026-9999' }]) {
      const r = await pay(forOrder, 100, 'production', extra);
      assert.equal(r.status, 400, JSON.stringify(extra));
      assert.equal(r.body.error, 'VALIDATION_FAILED');
      assert.match(r.body.message, /filled in by the system/);
    }
    assert.equal(await paymentCount(forOrder), 0);

    const r = await pay(forOrder, 100, 'admin');
    assert.equal(r.status, 201, r.text);
    assert.equal(r.body.payment.received_by, 'u-admin');
    assert.equal(r.body.payment.received_by_name, 'admin');
    const row = await t.get('SELECT received_by FROM payments WHERE payment_id = ?', [r.body.payment.payment_id]);
    assert.equal(row.received_by, 'u-admin');
  });

  it('saves an offline payment to sync later, without a receipt number yet', async () => {
    const r = await pay(await newOrder(1500), 200);
    assert.equal(r.status, 201, r.text);
    assert.equal(r.body.source, 'local');
    assert.match(r.body.message, /saved on this computer/);
    assert.deepEqual([r.body.payment.sync_status, r.body.payment.receipt_no, r.body.payment.received_by, r.body.payment.received_by_name],
      ['pending_insert', null, 'u-production', 'production']);
    assert.ok(t.localWrites.length > 0, 'the screens are told that a change is waiting to sync');
  });

  it('warns, without blocking, when the downpayment is still short of 50%', async () => {
    const id = await newOrder(1000);
    const r = await pay(id, 100);
    assert.equal(r.status, 201);
    assert.deepEqual(r.body.warnings, [{
      code: 'DOWNPAYMENT_SHORT',
      message: 'Not enough downpayment to start production: ₱400.00 more is needed (50% of the quote).'
    }]);
    const enough = await pay(id, 400);
    assert.deepEqual(enough.body.warnings.map((w) => w.code), ['DOWNPAYMENT_NOT_SYNCED'],
      'paid in full offline: it counts for approval once it syncs');
  });

  it('lists each payment with its receiver and the totals right after it (for the receipt)', async () => {
    const r = await t.request('GET', `/api/orders/${orders.main}/payments`, { token: t.tokens.owner });
    assert.equal(r.status, 200, r.text);
    assert.deepEqual(r.body.payments.map((p) => [p.amount, p.paid_to_date, p.remaining_after, p.status_after, p.received_by_name]), [
      [300, 300, 700, 'Partial', 'production'],
      [700, 1000, 0, 'Fully Paid', 'production']
    ]);
    assert.equal(r.body.totals.payment_status, 'Fully Paid');
    await t.run("INSERT INTO payments (payment_id, order_id, amount, payment_type, sync_status) VALUES ('old-pay', ?, 0, 'Cash', 'synced')", [orders.noQuote]);
    const legacy = await t.request('GET', `/api/orders/${orders.noQuote}`, { token: t.tokens.staff });
    assert.equal(legacy.body.payments[0].received_by_name, 'Not recorded', 'payments from before this update');
  });

  it('tells each role which payment buttons to show', async () => {
    const fresh = await newOrder(800);
    const detail = async (id, who) => (await t.request('GET', `/api/orders/${id}`, { token: t.tokens[who] })).body.allowed_actions;
    const prod = await detail(fresh, 'production');
    assert.deepEqual([prod.record_payment, prod.max_payment, prod.print_receipt, prod.payment_blocked_reason], [true, 800, true, null]);
    const staff = await detail(fresh, 'staff');
    assert.deepEqual([staff.record_payment, staff.max_payment, staff.print_receipt], [false, 0, true]);
    const cancelled = await detail(orders.cancelled, 'owner');
    assert.deepEqual([cancelled.record_payment, cancelled.payment_blocked_reason], [false, 'This order was cancelled, so it cannot take payments.']);
    const noQuote = await detail(orders.noQuote, 'admin');
    assert.deepEqual([noQuote.record_payment, noQuote.payment_blocked_reason], [false, 'The Owner must set the quote before payments can be recorded.']);
  });

  it('shows overpaid orders to the Owner and Admin for a refund, and adds receipt columns to the exports', async () => {
    // Two branches paid the same order while offline (sync accepts both, D2)
    await t.run("INSERT INTO payments (payment_id, order_id, amount, payment_type, received_by, sync_status) VALUES ('branch-b', ?, 250, 'GCash', 'u-owner', 'synced')", [orders.main]);
    const owner = await t.request('GET', '/api/reports/dashboard', { token: t.tokens.owner });
    const over = owner.body.orders.overpaid.find((o) => o.order_id === orders.main);
    assert.deepEqual([over.payment_status, over.overpaid_by], ['Overpaid', 250]);
    assert.equal(owner.body.orders.overpaid_total, 250);
    assert.ok(owner.body.orders.due_this_week.every((o) => typeof o.payment_status === 'string'));
    const staff = await t.request('GET', '/api/reports/dashboard', { token: t.tokens.staff });
    assert.deepEqual(staff.body.orders.overpaid, [], 'money figures stay with Owner and Admin');
    const detail = await t.request('GET', `/api/orders/${orders.main}`, { token: t.tokens.owner });
    assert.deepEqual([detail.body.totals.payment_status, detail.body.totals.overpaid_by, detail.body.totals.remaining], ['Overpaid', 250, 0]);

    const payments = await t.request('GET', '/api/reports/export/payments.csv', { token: t.tokens.owner });
    const lines = payments.text.slice(1).trim().split('\r\n');
    assert.equal(lines[0], 'Date,Receipt no.,Order,Customer,Payment type,Amount (PHP),Received by');
    assert.ok(lines.some((l) => /,Given after sync,New order,Juan Dela Cruz,Cash,300,production$/.test(l)), lines.join('\n'));
    assert.ok(lines.some((l) => /,Cash,0,Not recorded$/.test(l)), 'a payment from before this update');
    const ordersCsv = await t.request('GET', '/api/reports/export/orders.csv', { token: t.tokens.owner });
    assert.match(ordersCsv.text, /Balance \(PHP\),Payment status,Materials/);
    assert.match(ordersCsv.text, /,Overpaid,/);
  });
});

describe('Sync status (changes waiting to sync)', () => {
  let t;
  before(async () => {
    t = await startTestServer();
    await t.login('staff');
    await t.login('owner');
  });
  after(async () => { await t.close(); });

  it('reports the offline-only mode and counts the changes waiting, per table', async () => {
    assert.equal((await t.request('GET', '/api/sync/status')).status, 401, 'needs a login');
    const empty = await t.request('GET', '/api/sync/status', { token: t.tokens.staff });
    assert.equal(empty.status, 200, empty.text);
    assert.deepEqual([empty.body.cloud, empty.body.pending, empty.body.pending_total, empty.body.conflicts], ['disabled', {}, 0, 0]);

    const item = await t.request('POST', '/api/inventory', { token: t.tokens.owner, body: fixtures.ITEMS[1] });
    const cust = await t.request('POST', '/api/customers', { token: t.tokens.owner, body: fixtures.CUSTOMERS[1] });
    const order = await t.request('POST', '/api/orders', {
      token: t.tokens.owner,
