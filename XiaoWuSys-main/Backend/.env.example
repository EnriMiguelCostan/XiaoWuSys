# Copy this file to .env and fill it in. Never commit .env (it holds passwords).

# --- Cloud database (Neon PostgreSQL) ---
# Leave DATABASE_URL empty to run OFFLINE-ONLY on the local database (or use "npm run demo").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non "-pooler") URL for real-time stock updates across branches (optional)
PG_LISTEN_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Security ---
# Long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-value
# Frontend addresses allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173
# Wrong passwords allowed before a 15-minute lock (per username + computer)
LOGIN_MAX_FAILURES=5
# Set to 1 when running behind a reverse proxy (Render, Railway, nginx)
# TRUST_PROXY=1

# --- Server ---
PORT=5000
BUSINESS_TIMEZONE=Asia/Manila
# Apply database migrations automatically on start (set false to run "npm run migrate" by hand)
AUTO_MIGRATE=true
# Days an item stays in the Recycle Bin before it is permanently deleted
RECYCLE_BIN_RETENTION_DAYS=30
# Local SQLite file (default local_cache.db)
# LOCAL_DB_PATH=local_cache.db
# Force offline-only mode even if DATABASE_URL is set
# CLOUD_DISABLED=true
